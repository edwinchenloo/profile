# --- ls / ll — prefer eza (icons + colour); else colour-aware coreutils ls ----
if type eza &>/dev/null; then
    alias l="eza --icons=always"
    alias la="eza -a --icons=always"
    alias lh="eza -ad --icons=always .*"
    alias ls="eza --icons=always"
    alias ll="eza -lg --time-style=full-iso --icons=always"
    alias lla="eza -lag --icons=always"
    alias llh="eza -lagd --icons=always .*"
    alias llt="eza -lg --sort=modified --time-style=full-iso --icons=always"
    alias lt="eza -lTg --icons=always"
    alias lt2="eza -lTg --level=2 --icons=always"
    alias lt3="eza -lTg --level=3 --icons=always"
    alias lt4="eza -lTg --level=4 --icons=always"
    alias lta="eza -lTag --icons=always"
    alias lta2="eza -lTag --level=2 --icons=always"
    alias lta3="eza -lTag --level=3 --icons=always"
    alias lta4="eza -lTag --level=4 --icons=always"
else
    alias ls='/bin/ls --color=auto '
    if [ "$OS" = "Windows_NT" ]; then
        alias ll='ls -l -tr --color=always --full-time'
        alias llt='ls -l -tr --color=always --full-time'
    else
        alias ll='ls -l -tr --color=auto --full-time'
        alias llt='ls -l -tr --color=auto --full-time'
    fi
fi

_exe()
{
    [ $1 == on  ] && { set -x; return; } 2>/dev/null
    [ $1 == off ] && { set +x; return; } 2>/dev/null
    echo + "$@"
    "$@"
}

exe()
{
    { _exe "$@"; } 2>/dev/null
}

function clonem() {
    DIR_="${1:-monorepo}"
    git clone ssh://git@hq-stash.lnx.xrtrading.local:7999/mr/monorepo.git ${DIR_}
    cd ${DIR_}
    if [[ ${DIR_} != "monorepo" ]]; then
        git checkout ${DIR_}     # attempt to fetch existing branch
        git checkout -b ${DIR_}
    fi
}

function duc() {
    TXT_BLD=$(tput bold)
    TXT_RED=$(tput setaf 1)
    TXT_YLW=$(tput setaf 3)
    TXT_WARN="${TXT_BLD}${TXT_YLW}"
    TXT_ERR="${TXT_BLD}${TXT_RED}"
    TXT_RST=$(tput sgr0)
    IFS= mapfile -t disk < <(/usr/bin/df -h | tail -n +2)
    for line in "${disk[@]}"; do
        USAGE=$(echo $line | awk '{print $5/1}')
        if [[ "$USAGE" -gt '90' ]]; then
            echo "${TXT_ERR}$line${TXT_RST}"
        elif [[ "$USAGE" -gt '80' ]]; then
            echo "${TXT_WARN}$line${TXT_RST}"
        else
            echo "$line"
        fi
    done
}

function extract()      # Handy Extract Program
{
    if [ -f $1 ] ; then
        case $1 in
            *.tar.bz2)   tar xvjf $1     ;;
            *.tar.gz)    tar xvzf $1     ;;
            *.bz2)       bunzip2 $1      ;;
            *.rar)       unrar x $1      ;;
            *.gz)        gunzip $1       ;;
            *.tar)       tar xvf $1      ;;
            *.tbz2)      tar xvjf $1     ;;
            *.tgz)       tar xvzf $1     ;;
            *.zip)       unzip $1        ;;
            *.Z)         uncompress $1   ;;
            *.7z)        7z x $1         ;;
            *)           echo "'$1' cannot be extracted via >extract<" ;;
        esac
    else
        echo "'$1' is not a valid file!"
    fi
}

function gc()
{
    if [ $# -eq 0 ]
    then
      echo "usage:  gc 'git commit message'"
      return
    fi
    BRANCH=$(git rev-parse --abbrev-ref HEAD)
    if [ $BRANCH == "master" ] || [ $BRANCH == "" ]
    then
        echo "cannot commit to master"
        return
    fi

    COMMENT="$1"
    [[ "${COMMENT}" == \"*\" || "${COMMENT}" == \'*\' ]] && COMMENT="${COMMENT:1:-1}"
    git commit -a -m "$BRANCH:$COMMENT"
    if [ $BRANCH == "master" ]; then
        echo "***** Warning:commited to master *****" >&2
    fi
}

function grmb()
{
    BRANCH=$(git rev-parse --abbrev-ref HEAD)
    if [ $BRANCH == "master" ] || [ $BRANCH == "" ]
    then
        echo "use this while on the git branch to be deleted"
        return
    fi

    git checkout master
    git pull --rebase
    git branch -d "$BRANCH"
    git push origin --delete "$BRANCH"
}

