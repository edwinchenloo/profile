function scpssh() {
    if [ -z "$1" ] || [ -z "$2" ]
    then
        echo "scpssh {user} {host}"  # copy pub key into users's .ssh/authorized_keys
        return
    fi

    exe ssh-copy-id -f -i id_rsa.pub $1@$2
}


function u() {
    uncrustify -c /home/${USER_EDWIN}/utils/uncrustify.cfg -l CPP --replace $1
}



# Resolve a false Bitbucket submodule-conflict on a PR branch by merging
# master locally (git can fast-forward the submodule gitlink that Bitbucket
# cannot) and pushing the result back.  Usage: gconflict <branch>
function gconflict() {
    if [ -z "$1" ]
    then
        echo "gconflict {branch}   # merge master into branch, resolve submodule conflict, push"
        return 1
    fi

    local branch="$1"

    git fetch origin "${branch}" master && \
    git checkout -B "${branch}" "origin/${branch}" && \
    git merge origin/master --no-edit && \
    git push origin "${branch}"
}
